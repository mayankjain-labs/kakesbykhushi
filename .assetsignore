# Files Cloudflare should NOT upload as website assets.
# (gitignore syntax) — keeps the deploy under the 25 MiB per-file limit
# and out of version-control / build junk.

# Version control (the .git pack file is >25 MiB and must be excluded)
.git
.gitignore

# CI / tooling / docs — not part of the website
.github
scripts
node_modules
README.md
WHATSAPP-SETUP.md

# Raw, unoptimized source media (the site uses assets/designs/* instead)
simplecakes
specialcakes
posters.jpeg
*.zip
*.pdf

# This ignore file itself
.assetsignore
